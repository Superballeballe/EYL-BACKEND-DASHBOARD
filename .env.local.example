# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored; THIS example file is committed — keep it free of secrets.

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role / secret key (SECRET - server only, never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key (optional; only for future browser-side Supabase calls)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: direct Postgres connection (use the IPv4 "Session pooler" string for migrations/tools)
DATABASE_URL=

# ---- App auth ----
# Secret used to sign session cookies (long random string)
SESSION_SECRET=replace-with-a-long-random-string
# API key required in the `x-api-key` header for write/automation endpoints
API_KEY=replace-with-a-long-random-string
# ---- Invite & auth email (Resend) ----
# 1. Create an API key at https://resend.com/api-keys
# 2. Add & verify your domain at https://resend.com/domains (required on Pro)
# 3. Use an address on that domain below, e.g. EYL Ops <ops@mail.yourdomain.com>
RESEND_API_KEY=re_xxxxxxxx
# Must be a full email on your verified Resend domain. No spaces unless quoted:
# INVITE_FROM_EMAIL="EYL Ops <ops@yourdomain.com>"
INVITE_FROM_EMAIL=ops@yourdomain.com
# Public URL users click in emails (production URL, not localhost, for real mail)
# Local dev: http://localhost:3000
# Production: https://eyl.adamantium.digital
APP_URL=http://localhost:3000

# Legacy shared password (removed — use /setup for first admin account)
# APP_PASSWORD=

# ---- Google Maps (delivery form + route plotting map) ----
# Enable Maps JavaScript API, Places API, Directions API, and Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
